# ------------------------------------------------------------
# Frontend environment variables (Vite)
#
# These values are compiled into the production bundle. Set the
# same three URLs in the Vercel project for the Production,
# Preview and Development environments, then redeploy.
# ------------------------------------------------------------

# WebRTC signaling (Socket.IO) service on Render
VITE_WEBRTC_URL=https://meet-2-deploying.onrender.com

# Translation / auth / transcript service on Render
VITE_TRANSLATION_URL=https://meet-2-deploying-1.onrender.com

# AI anchoring service on Render (separate from the two above)
VITE_ANCHORING_URL=https://meet-2-deploying-2.onrender.com

# Optional TURN relay for peers behind symmetric NATs.
# Leave empty to use public STUN only. Never commit real credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# For local development, use:
# VITE_WEBRTC_URL=http://localhost:3001
# VITE_TRANSLATION_URL=http://localhost:5000
# VITE_ANCHORING_URL=http://localhost:3002
