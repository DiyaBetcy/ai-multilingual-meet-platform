# ------------------------------------------------------------
# Backend environment variables
#
# The same backend folder hosts three independent services:
#   npm run start:webrtc      -> webrtc-server.js
#   npm run start:translation -> translation.js
#   npm run start:anchoring   -> anchoring-service.js
#
# Render sets PORT automatically; do not hardcode a production port.
# Values below are placeholders. Never commit real secrets.
# ------------------------------------------------------------

PORT=5000

# Comma-separated browser origins allowed to connect (optional).
# Leave empty to allow any origin. Credentials are not used.
CLIENT_ORIGIN=https://meet-ai-anchoring.vercel.app

# Translation / auth service
MONGO_URI=
MONGO_DB_NAME=
JWT_SECRET=
FRONTEND_URL=https://meet-ai-anchoring.vercel.app

# Sarvam AI Text-to-Speech (translation + anchoring TTS)
SARVAM_API_KEY=

# Optional OTP email delivery
EMAIL_USER=
EMAIL_PASS=
